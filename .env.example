# Web (Google Identity Services)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Server verification (used by /api/auth/google)
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# Toggle login availability (set to 'false' to disable login UI)
NEXT_PUBLIC_LOGIN_ENABLED=true

# Disable only Google login buttons (keep email/password)
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=true

# AdMob banner behavior (optional)
# Show close button after X seconds
NEXT_PUBLIC_ADMOB_CLOSE_DELAY_SECONDS=10
# Allow showing the close button (true/false)
NEXT_PUBLIC_ADMOB_ALLOW_CLOSE=true
# After closing, reshow banner after N minutes
NEXT_PUBLIC_ADMOB_RESHOW_MINUTES=5

# Ad unit IDs (optional, defaults to Google test IDs if empty)
# Interstitial video (short)
NEXT_PUBLIC_ADMOB_INTERSTITIAL_ID=
# Rewarded video (long ~30s)
NEXT_PUBLIC_ADMOB_REWARDED_ID=

# Ad rules
# Prints threshold: show interstitial every N printed labels
NEXT_PUBLIC_ADS_PRINTS_THRESHOLD=5
# Cooldown between any two videos (seconds)
NEXT_PUBLIC_ADS_COOLDOWN_SECONDS=60
# Global minimum interval between any videos (minutes, 0 to disable)
NEXT_PUBLIC_ADS_GLOBAL_MINUTES=0

# Firebase Web SDK (optional if you want Firebase services)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Notes:
# - For Android, add google-services.json to android/app/
# - Create an Android OAuth client in Google Cloud with package name
#   com.rubensaguiarofc.controleestoque and your SHA-1/SHA-256.
