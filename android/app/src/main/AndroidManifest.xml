<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permissão adicional para acesso amplo a arquivos (MANAGE_EXTERNAL_STORAGE).
         Uso desta permissão exige justificativa na Play Store e, em runtime, o usuário
         precisa conceder o acesso nas configurações do app (Manage all files access).
         Adicione esta permissão apenas se realmente precisar acessar arquivos fora
         do escopo do app. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google Mobile Ads App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ADMOB_APP_ID}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Permissão obrigatória para o leitor de código de barras -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Declaramos a feature de câmera como não obrigatória para permitir instalação em dispositivos sem câmera -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Permissões para salvar/ler arquivos (importante para o PDF) -->
    <!-- maxSdkVersion="32" é usado porque o Android 13 mudou a forma de acesso a mídias -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Permissão de ID de anúncios (necessária para Ads em Android 13+) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
</manifest>
